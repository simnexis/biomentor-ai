# Copy this file to `.env` (never commit `.env`). Every value is optional.
# Alternatively put GEMINI_API_KEY in .streamlit/secrets.toml (see .streamlit/secrets.toml.example).

# Optional: enables Gemini-generated explanations, summaries, comparisons and quizzes.
# Search, retrieval, evidence inspection and evaluation work without it.
GEMINI_API_KEY=YOUR_KEY_HERE

# Gemini model identifier (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# NCBI asks API users to identify themselves. Email is strongly recommended.
NCBI_EMAIL=you@example.com
# Optional NCBI API key (raises the rate limit from 3 to 10 requests/second).
NCBI_API_KEY=

# Embedding model used for dense retrieval (downloaded from Hugging Face on first use).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
